<?xml version="1.0" encoding="utf-8"?>
<!-- Allows the app to reach alert-service over plain HTTP on the LAN
     (e.g. http://192.168.x.x:8090). Fine for this LAN demo; for production,
     serve the app API over HTTPS and remove this. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
